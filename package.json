{
  "name": "screenlift",
  "productName": "ScreenLift",
  "version": "1.0.0",
  "description": "Cast your whole screen or a single app window to a TV — Chromecast/Google TV (low-latency Cast Streaming), DLNA smart TVs, any browser, or a wired/AirPlay display. Mac + Windows.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:dir": "electron-builder --dir",
    "icons": "bash scripts/make-icons.sh"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.screenlift.desktop",
    "productName": "ScreenLift",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "ScreenLift uses the local network to find TVs and send the picture to them.",
        "NSBonjourServices": [
          "_googlecast._tcp"
        ],
        "NSMicrophoneUsageDescription": "Needed to send the audio input you select to the TV.",
        "NSScreenCaptureUsageDescription": "Needed to cast your screen or the app window you select."
      },
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ScreenLift",
      "uninstallDisplayName": "ScreenLift",
      "createDesktopShortcut": true
    },
    "icon": "build/icon.png",
    "artifactName": "ScreenLift-${version}-${arch}.${ext}",
    "dmg": {
      "title": "ScreenLift ${version}"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eminvergil/screenlift.git"
  }
}
